# Runtime receives environment variables, not a dotenv loader. Replace dummy secrets.
ASPNETCORE_URLS=http://0.0.0.0:5080
ASPNETCORE_ENVIRONMENT=Production
Mongo__Uri=mongodb://mongo:27017
Mongo__Database=user_management
Jwt__Secret=
Jwt__Issuer=user-management
Jwt__Audience=user-management-browser
Jwt__ExpiryMinutes=30
# Optional when deployed same-origin; local Angular origin if needed.
Cors__AllowedOrigins__0=http://localhost:4200
Bootstrap__Enabled=true
Bootstrap__Username=local-admin
Bootstrap__Password=
